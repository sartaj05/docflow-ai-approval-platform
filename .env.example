20. Important Fix for Docker .env

When running with Docker, your .env should use this:

DATABASE_HOST=db
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
AI_SERVICE_URL=http://ai_service:8001

When running locally without Docker, use this:

DATABASE_HOST=localhost
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
AI_SERVICE_URL=http://localhost:8001




OCR_ENABLED=True
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANGUAGE=eng
OCR_MIN_CONFIDENCE=60
OCR_PDF_MAX_PAGES=5
POPPLER_PATH=C:\poppler\Library\bin



























# ==============================
# DJANGO
# ==============================

DJANGO_SETTINGS_MODULE=config.settings.prod

SECRET_KEY=change-this-to-a-long-random-production-secret-key
DEBUG=False

ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com,http://localhost:8000,http://127.0.0.1:8000

DOCFLOW_APP_URL=https://your-domain.com

# ==============================
# DATABASE
# ==============================

DATABASE_NAME=docflow_ai
DATABASE_USER=docflow_user
DATABASE_PASSWORD=change-this-db-password
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_CONN_MAX_AGE=60

POSTGRES_DB=docflow_ai
POSTGRES_USER=docflow_user
POSTGRES_PASSWORD=change-this-db-password

# ==============================
# REDIS / CELERY
# ==============================

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ==============================
# EMAIL / SMTP
# ==============================

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@docflowai.local

ENABLE_EMAIL_NOTIFICATIONS=True
SEND_EMAIL_ASYNC=True

# ==============================
# SECURITY
# ==============================

SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=False

# Use True only when Nginx/SSL proxy headers are correctly configured
USE_X_FORWARDED_HOST=True
USE_X_FORWARDED_PORT=True

# ==============================
# UPLOADS
# ==============================

STATIC_URL=/static/
MEDIA_URL=/media/
MAX_UPLOAD_SIZE_MB=10

# ==============================
# AI SERVICE OPTIONAL
# ==============================

AI_SERVICE_URL=http://ai-service:8001
AI_SERVICE_TIMEOUT=15

# ==============================
# LOGGING
# ==============================

DJANGO_LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO
CELERY_LOG_LEVEL=INFO